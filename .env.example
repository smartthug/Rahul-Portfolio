# --- Contact form (Resend) -------------------------------------------------
# Sign up free at https://resend.com -> API Keys -> create -> paste below.
# Free tier covers 3,000 emails / month. No credit card required.
RESEND_API_KEY=

# Where contact-form submissions are delivered.
#
# IMPORTANT — Resend sandbox restriction:
# Until you verify a domain at https://resend.com/domains, Resend will ONLY
# deliver to the email address you signed up with. Trying to send to anyone
# else returns 403 ("testing emails to your own email address").
# Quickest workaround: set this to the same address you used on resend.com,
# then forward that inbox to wherever you actually want messages to land.
CONTACT_TO_EMAIL=thugsmart6@gmail.com

# From address. ONLY the default below works without verifying a domain.
# If you set this to "anything <hi@yourdomain.com>" you MUST verify yourdomain.com
# on https://resend.com/domains first — otherwise Resend returns 403.
# The route handler auto-falls-back to the onboarding sender if your custom
# domain isn't verified yet, so the form keeps working during setup.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
